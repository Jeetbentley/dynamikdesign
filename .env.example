# Copy to .env.local for local development, and set the same names in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Tile waitlist — Google Apps Script web app (see scripts/tile-waitlist.gs)
WAITLIST_WEBHOOK_URL=
WAITLIST_SECRET=

# Optional: confirmation + notification emails. Leave blank to skip email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
